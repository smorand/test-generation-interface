{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Functional test",
  "description": "One test of one scenario, as written in tests/all_tests.json by the export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "scenario_id",
    "name",
    "description",
    "requirement_refs",
    "steps",
    "data_rows",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TEST-[0-9]+$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^SC-[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "requirement_refs": {
      "type": "array",
      "description": "Identifiers the document declares, as written in it",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "description",
          "expected_result"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          },
          "expected_result": {
            "type": "string"
          }
        }
      }
    },
    "data_rows": {
      "type": "array",
      "description": "Parameter sets for a test run several times over data",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "rejected"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "coverage_note": {
      "type": "string",
      "maxLength": 300,
      "description": "Why phase 3 completed or added this test, present only when it did"
    }
  }
}
