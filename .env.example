TGI_ICA_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica/v1
TGI_ICA_API_KEY=your_token_here
TGI_MODEL_GENERATOR=gemma-4-26b-a4b-it
TGI_MODEL_JUDGE=gemma-4-26b-a4b-it
TGI_MAX_JUDGE_PASSES=3
TGI_MAX_PARALLEL_BLOCS=5
TGI_LLM_JSON_RETRIES=5
TGI_JUDGE_SCORE_MODE=coverage
TGI_JUDGE_PASS_SCORE=80
TGI_JUDGE_BAD_SCORE=40
TGI_JUDGE_BATCH_RULES=10
TGI_GENERATOR_BATCH_RULES=8
TGI_CHUNK_SIZE=4000
TGI_CHUNK_OVERLAP=200
TGI_MAX_TESTS_PER_RULE=4
TGI_TEST_SIMILARITY_THRESHOLD=0.9
TGI_MAX_CONTEXT_TOKENS=128000
TGI_MAX_OUTPUT_TOKENS=16000
TGI_PROJECTS_DIR=./projects

# Optional: logging + tracing
