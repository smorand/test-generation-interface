# Any OpenAI compatible endpoint (vLLM, SGLang, a gateway, a hosted API)
TGI_LLM_BASE_URL=http://localhost:8000/v1
TGI_LLM_API_KEY=your_token_here   # any non empty value if the server needs none
# TLS. Behind a gateway that re-signs certificates, give the corporate bundle:
# TGI_LLM_CA_BUNDLE=/path/to/corporate-ca.pem
# Last resort, skips verification entirely and exposes the traffic:
TGI_LLM_VERIFY_SSL=true
TGI_MODEL_GENERATOR=gemma-4-26b-a4b-it
TGI_MODEL_JUDGE=gemma-4-26b-a4b-it
# Target number of tests per scenario. A target, not a cap.
TGI_TESTS_PER_SCENARIO=5
TGI_MAX_PARALLEL_BLOCS=5
# Non standard body field, only accepted by vLLM/SGLang. Enable it for a
# reasoning model (Qwen3.6 thinks by default) once the endpoint accepts it.
TGI_DISABLE_THINKING=false
TGI_LLM_JSON_RETRIES=5
TGI_TEST_SIMILARITY_THRESHOLD=0.9
TGI_RULE_SIMILARITY_THRESHOLD=0.9
TGI_MAX_CONTEXT_TOKENS=128000
TGI_MAX_OUTPUT_TOKENS=16000
# Adresse d'écoute du serveur. Changez le port si 8080 est déjà pris.
TGI_HOST=127.0.0.1
TGI_PORT=8080
TGI_PROJECTS_DIR=./projects

# Optional: logging and tracing.
# TGI_LOGS holds BOTH files: tgi.log and tgi-otel.log (JSONL spans).
# TGI_LOGS=/path/to/logs
# Set an OTLP HTTP traces endpoint to also ship spans to a collector (batched).
# TGI_OTEL_DESTINATION=http://otel-collector.example.com:4318/v1/traces
# TGI_OTEL_API_KEY=your_otel_token
