+++# ---------------------------------------------------------------------------
+++# SC-002 — a received identifier never composes a path unvalidated
+++# ---------------------------------------------------------------------------
+++
+++_BODY = {"hash": "HEAD", "message": "q", "decision": "accepted", "name": "x"}
+++_PATH_FILLERS = {"scenario_id": "SC-001", "test_id": "TEST-0001", "ref": "RM01", "index": "0"}
